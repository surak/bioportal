# Copy to .env and fill in. Never commit the real file.
DJANGO_SECRET_KEY=generate-with-get_random_secret_key
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=bioportal.fz-juelich.de
DJANGO_CSRF_ORIGINS=https://bioportal.fz-juelich.de
SITE_BASE_URL=https://bioportal.fz-juelich.de

# Postgres (omit DB_HOST entirely to fall back to SQLite for local dev)
DB_HOST=localhost
DB_NAME=bioportal
DB_USER=bioportal
DB_PASSWORD=

# Helmholtz AAI / JSC Unity
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=https://login.helmholtz.de/oauth2
# Comma-separated; empty means any successful login is accepted.
OIDC_ALLOWED_ENTITLEMENTS=

# Blablador molecular shim. A normal Blablador API key; held only by this
# backend and never sent to the browser.
BLABLADOR_API_BASE=https://api.blablador.fz-juelich.de/v1
BLABLADOR_API_KEY=

# Where result archives are copied. The service deletes them 48 h after a job
# finishes, so this store is what makes results durable. Size it accordingly.
ARTIFACT_ROOT=/p/scratch/your-project/bioportal/artifacts
MAX_ARTIFACT_BYTES=2000000000
ARTIFACT_RETENTION_SECONDS=172800

# A job still "running" after this long is flagged for operations; upstream has
# no automatic requeue for jobs whose worker was lost.
STALE_RUNNING_SECONDS=108000

# Mail
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.fz-juelich.de
EMAIL_PORT=25
DEFAULT_FROM_EMAIL=bioportal@fz-juelich.de

MAX_ACTIVE_JOBS_PER_USER=5
